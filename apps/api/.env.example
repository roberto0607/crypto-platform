# ── Required ──
# Local dev DB runs in Docker on port 5435 (see root docker-compose.yml,
# service `tradr_postgres`). `cd apps/api && pnpm bootstrap` starts it.
DATABASE_URL=postgresql://cp:cp@localhost:5435/cp
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-string

# ── Server ──
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── JWT ──
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# ── Redis (optional — omit for in-memory fallback) ──
# REDIS_URL=redis://localhost:6379

# ── Instance (multi-instance deployment) ──
# INSTANCE_ID=api-1
# INSTANCE_ROLE=ALL  # API | WORKER | ALL

# ── Database Pool ──
# DB_POOL_MAX=20
# DB_SLOW_QUERY_MS=200

# ── Feature Flags ──
# DISABLE_RATE_LIMIT=false
# DISABLE_JOB_RUNNER=false
# BETA_MODE=false
# LOAD_SHEDDING_ENABLED=true
# RUN_MIGRATIONS_ON_BOOT=false

# ── Security ──
# MAX_LOGIN_ATTEMPTS_PER_EMAIL=5
# MAX_LOGIN_ATTEMPTS_PER_IP=20
# LOGIN_BLOCK_WINDOW_MINUTES=15
# MAX_API_KEY_REQ_PER_MIN=120

# ── Queue ──
# MAX_QUEUE_DEPTH=100
# QUEUE_TIMEOUT_MS=5000

# ── Outbox Worker ──
# OUTBOX_WORKER_ENABLED=true
# OUTBOX_BATCH_SIZE=50
# OUTBOX_POLL_INTERVAL_MS=1000

# ── Email (optional — omit for dev console logging) ──
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# EMAIL_FROM=noreply@yourplatform.com
# APP_URL=https://yourplatform.com

# ── Email Verification ──
# REQUIRE_EMAIL_VERIFICATION=false  # Set to true to block unverified users from trading

# ── Gate 1e: human-alerting escalation (optional — omit to log-and-skip) ──
# OPS_ALERT_EMAIL=ops@yourplatform.com  # Paged when the Execution Agent's crash-recovery retry also fails

# ── Dev seed (scripts/seed-dev-user.ts, `pnpm dev:me`) ──
# Password for the local dev account; required by the seed, no default. Never commit a real value.
SEED_DEV_USER_PASSWORD=

# ── Proxy (landing quick-call per-IP limit) ──
# Reverse-proxy hops whose X-Forwarded-For Fastify trusts for req.ip. 0 = off.
# TRUST_PROXY_HOPS=1

# ── Storage budget (DB recovery) ──
# Pairs whose market-data history (candles, footprint) is written to Postgres.
# Every other active pair still streams live but stores nothing. Default below.
# MARKET_SYMBOLS=BTC-USD,ETH-USD,SOL-USD
# Master switch for all agents. Defaults to false in production (true elsewhere);
# when false it overrides every *_AGENT_ENABLED flag.
# AGENTS_ENABLED=false
# agent_run_logs: errors + action runs always kept; plain successes kept as one
# heartbeat per agent per N minutes plus a random sample.
# AGENT_LOG_SAMPLE_RATE=0.05
# AGENT_LOG_HEARTBEAT_MINUTES=30
# Storage-retention job (hourly, batched). Days; 0 = keep forever. 1h/4h/1d/1w are always kept.
# RETENTION_CANDLE_1M_DAYS=30
# RETENTION_CANDLE_5M_DAYS=365
# RETENTION_CANDLE_15M_DAYS=365
# RETENTION_AGENT_RUN_LOG_DAYS=14
# RETENTION_OUTBOX_DONE_DAYS=7
# Disk-pressure guardrail. Set to the Postgres volume size in MB. DB size (+WAL when
# readable) is logged hourly; warn at 70%, at 85% agents/agent logs/footprint pause.
# DB_SIZE_LIMIT_MB=5120
# DB_SIZE_WARN_PCT=70
# DB_SIZE_CRITICAL_PCT=85

# ── Feed watchdogs (src/market/feedWatchdog.ts, wired in krakenWs.ts) ──
# Per-symbol Kraken book staleness. Off = detect + log feed_watchdog_would_kill only.
# FEED_WATCHDOG_KILL_ENABLED=false
# FEED_KRAKEN_BOOK_STALE_MS=10000
# Kraken v2 heartbeat (~1/s): kill on silence is on by default.
# FEED_KRAKEN_HEARTBEAT_KILL_ENABLED=true
# FEED_KRAKEN_HEARTBEAT_STALE_MS=5000
# FEED_WATCHDOG_GRACE_MS=10000
# Kraken book CRC32 checksum: always verified + logged/counted. Enforce = on
# mismatch drop that symbol's book and resubscribe just it (cooldown, mass
# mismatch → one reconnect, no fresh snapshot within the timeout → reconnect).
# KRAKEN_BOOK_CHECKSUM_ENFORCE=false
# KRAKEN_BOOK_RESYNC_COOLDOWN_MS=5000
# KRAKEN_BOOK_RESYNC_TIMEOUT_MS=10000
# KRAKEN_BOOK_MASS_MISMATCH_SYMBOLS=5
# KRAKEN_BOOK_MASS_MISMATCH_WINDOW_MS=10000
# Coinbase (src/feeds/coinbaseWs.ts): heartbeats channel kill is on by default;
# the per-symbol "silent on Coinbase while Kraken trades" cross-check is log-only.
# FEED_COINBASE_HEARTBEAT_KILL_ENABLED=true
# FEED_COINBASE_HEARTBEAT_STALE_MS=5000
# FEED_COINBASE_SYMBOL_KILL_ENABLED=false
# FEED_COINBASE_SYMBOL_STALE_MS=60000
